# Required for a stable client link. Generate a UUID and paste it here.
UUID=

# Railway sets this automatically after you generate a service domain.
# You normally do not need to set it manually.
DOMAIN=

# VLESS WebSocket path.
WS_PATH=/whitedns

# Railway injects PORT automatically. 8080 is only the local fallback.
PORT=8080

# Optional: debug, info, warning, error, none
XRAY_LOG_LEVEL=warning
